#!/bin/sh
# Launcher para entrar no terminal Debian interativo via LinuxNative
set -e

SCRIPT="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
if [ -z "$LN_ROOT" ]; then
    if [ -d "/data/data/com.termux/files/home/debian-rootfs" ]; then
        ROOT_DIR="/data/data/com.termux/files/home/debian-rootfs"
    else
        ROOT_DIR="/data/data/com.termux/files/usr/glibc"
    fi
else
    ROOT_DIR="$LN_ROOT"
fi

if [ ! -f "$DIR/build/lnative" ]; then
    echo "Compilando LinuxNative..."
    clang -O2 -g -std=c11 -Wall -Wextra -Werror -fno-strict-aliasing \
        "$DIR/src/main.c" "$DIR/src/elf.c" "$DIR/src/runtime.c" "$DIR/src/gateway.S" \
        -o "$DIR/build/lnative"
fi

if [ $# -eq 0 ]; then
    echo "=================================================="
    echo " Entrando no terminal Debian GNU/Linux (aarch64)  "
    echo " Sem root, sem ptrace, via LinuxNative runtime!   "
    echo " Digite 'exit' para sair.                         "
    echo "=================================================="
    exec "$DIR/build/lnative" --root "$ROOT_DIR" /bin/bash -i
else
    exec "$DIR/build/lnative" --root "$ROOT_DIR" /bin/bash "$@"
fi
